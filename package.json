{
  "name": "ntp-lms-ui",
  "version": "0.1.0",
  "description": "Custom UI kit for NTP LMS platform",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.11",
    "storybook": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "playwright": "latest"
  }
}
